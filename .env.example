# Copy this file to .env and edit only the database values.
# XAMPP default MySQL settings usually use root with an empty password.
DATABASE_URL=mysql://root:@127.0.0.1:3306/uov_timetable
JWT_SECRET=replace-this-with-a-long-random-secret

# Local login is used by this project; Manus OAuth is not required.
LOCAL_DEMO_MODE=false
VITE_LOCAL_DEMO_MODE=false
PORT=3000

# Optional email adapter. It must accept POST JSON: { to, subject, text, from }.
EMAIL_WEBHOOK_URL=
EMAIL_FROM=timetable@vau.ac.lk
